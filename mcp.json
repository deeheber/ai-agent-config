{
  "aws-iac-mcp-server": {
    "type": "stdio",
    "command": "uvx",
    "args": ["awslabs.aws-iac-mcp-server@latest"],
    "env": {
      "AWS_PROFILE": "default"
    }
  },
  "aws-mcp": {
    "type": "stdio",
    "command": "uvx",
    "args": [
      "mcp-proxy-for-aws==1.7.0",
      "https://aws-mcp.us-east-1.api.aws/mcp"
    ],
    "env": {
      "AWS_MCP_PROXY_PROFILES": "prod-readonly dev staging"
    }
  }
}
