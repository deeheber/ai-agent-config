{
  "aws-mcp": {
    "command": "uvx",
    "args": [
      "mcp-proxy-for-aws-cli@latest",
      "https://aws-mcp.us-east-1.api.aws/mcp"
    ],
    "env": {
      "AWS_MCP_PROXY_PROFILES": "dev staging prod-readonly"
    }
  },
  "aws-iac-mcp-server": {
    "command": "uvx",
    "args": ["awslabs.aws-iac-mcp-server@latest"],
    "env": {
      "AWS_PROFILE": "default"
    }
  }
}
